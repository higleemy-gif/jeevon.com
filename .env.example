# Copy this file to `.env.local` and fill in your values, then restart `npm run dev`.
# Only VITE_-prefixed variables are exposed to the browser.

# --- Supabase (local / self-hosted) ----------------------------------------
# Default URL for the Supabase CLI stack. Change the host/port if yours differs.
VITE_SUPABASE_URL=http://127.0.0.1:54321

# The ANON (public) key — never put the service_role key in a frontend .env.
# Find it with: supabase status
VITE_SUPABASE_ANON_KEY=your-local-anon-key

# --- WhatsApp ---------------------------------------------------------------
# The number that receives every order. Digits only, country code first,
# no "+", spaces or dashes.  +91 98765 43210  ->  919876543210
VITE_WHATSAPP_NUMBER=918144247345

# --- Display (optional) -----------------------------------------------------
# Used only to format product prices. Defaults: INR / en-IN.
VITE_CURRENCY=INR
VITE_LOCALE=en-IN
